# TeAtende — Caddy (alternativa mais simples ao Nginx: emite e renova o HTTPS sozinho).
# Instalar em: /etc/caddy/Caddyfile   |   Raiz do site: /var/www/rbitecnologia
# Pré-requisito: o DNS já apontando para esta VPS e as portas 80 e 443 liberadas.
# Use Caddy OU Nginx, não os dois: ambos querem as portas 80/443.

rbitecnologia.com.br {
	root * /var/www/rbitecnologia
	encode zstd gzip

	# Segurança
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Cache: HTML/CSS/JS sempre revalidam (304, barato); fontes e imagens ficam em cache longo.
	# Os três matchers são mutuamente exclusivos (cada arquivo cai em exatamente uma regra):
	# um "default" seguido de um específico NÃO funciona, o primeiro vence.
	@fontes path *.woff2
	@imagens path *.webp *.png *.jpg *.jpeg *.svg *.ico
	@revalida not path *.woff2 *.webp *.png *.jpg *.jpeg *.svg *.ico
	header @fontes Cache-Control "public, max-age=31536000, immutable"
	header @imagens Cache-Control "public, max-age=2592000"
	header @revalida Cache-Control "no-cache"

	# Esconde arquivos ocultos (.git, .htaccess etc.)
	@ocultos path /.*
	respond @ocultos 404

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.rbitecnologia.com.br {
	redir https://rbitecnologia.com.br{uri} permanent
}
